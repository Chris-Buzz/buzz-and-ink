{
  "name": "@buzz-ink/react",
  "version": "0.2.0",
  "description": "React components for the Buzz & Ink design system — typed wrappers over the buzz-and-ink CSS.",
  "license": "MIT",
  "author": "Christopher Buzaid <cjpbuzaid@gmail.com>",
  "homepage": "https://github.com/Chris-Buzz/buzz-and-ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chris-Buzz/buzz-and-ink.git",
    "directory": "react"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "editorial"
