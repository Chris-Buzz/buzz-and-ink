node_modules/

# build output — regenerated by `npm run build`, published to npm via package.json "files"
dist/
.vite/

# secrets & local config — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc
.netrc

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-error.log*

# browser-verification artifacts (screenshots land in the repo root)
.playwright-mcp/
/*.png
