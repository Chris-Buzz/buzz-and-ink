{
  "name": "buzz-and-ink",
  "version": "0.8.0",
  "description": "Buzz & Ink — an editorial design system in warm cream, working orange, and rich ink. Tokens-first, framework-agnostic CSS with switchable edge personalities, OKLCH bring-your-own-color theming, a motion layer, and token-driven charts.",
  "license": "MIT",
  "type": "module",
  "author": "Christopher Buzaid <cjpbuzaid@gmail.com>",
  "homepage": "https://github.com/Chris-Buzz/buzz-and-ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chris-Buzz/buzz-and-ink.git"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "ui",
    "editorial",
    "charts",
    "motion",
    "theming",
    "animation",
    "dataviz"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "style": "src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./tokens": "./src/tokens.css",
    "./components": "./src/components.css",
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./motion": {
      "types": "./src/motion.d.ts",
      "default": "./src/motion.js"
    },
    "./graph": {
      "types": "./src/graph.d.ts",
      "default": "./src/graph.js"
    },
    "./icons": {
      "types": "./src/icons.d.ts",
      "default": "./src/icons.js"
    },
    "./charts": {
      "types": "./src/charts.d.ts",
      "default": "./src/charts.js"
    },
    "./themer": {
      "types": "./src/themer.d.ts",
      "default": "./src/themer.js"
    }
  },
  "scripts": {
    "docs": "npx serve . -l 5177"
  }
}
