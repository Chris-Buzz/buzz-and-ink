{
  "name": "buzz-and-ink",
  "version": "0.9.0",
  "description": "Buzz & Ink — a complete, dependency-free editorial design system. Tokens-first CSS, 240+ components, OKLCH bring-your-own-color theming, a motion layer, accessible token-driven charts, and an opt-in play layer.",
  "license": "MIT",
  "type": "module",
  "author": "Christopher Buzaid <cjpbuzaid@gmail.com>",
  "homepage": "https://github.com/Chris-Buzz/buzz-and-ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chris-Buzz/buzz-and-ink.git"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "ui",
    "editorial",
    "components",
    "charts",
    "dataviz",
    "motion",
    "animation",
    "theming",
    "oklch",
    "accessible",
    "a11y",
    "zero-dependency",
    "framework-agnostic"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "style": "src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./tokens": "./src/tokens.css",
    "./components": "./src/components.css",
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./motion": {
      "types": "./src/motion.d.ts",
      "default": "./src/motion.js"
    },
    "./graph": {
      "types": "./src/graph.d.ts",
      "default": "./src/graph.js"
    },
    "./icons": {
      "types": "./src/icons.d.ts",
      "default": "./src/icons.js"
    },
    "./charts": {
      "types": "./src/charts.d.ts",
      "default": "./src/charts.js"
    },
    "./themer": {
      "types": "./src/themer.d.ts",
      "default": "./src/themer.js"
    }
  },
  "scripts": {
    "test": "node --test test/run.js",
    "docs": "npx serve . -l 5177",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "Firefox ESR"
  ],
  "dependencies": {}
}
